{
  "name": "fortune-lane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"pnpm --filter @fortune/server dev\" \"pnpm --filter @fortune/web dev\"",
    "build": "pnpm --filter @fortune/web build && pnpm --filter @fortune/server build",
    "start": "pnpm --filter @fortune/server start",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write apps/web/src scripts/ui-snapshots.mjs",
    "format:check": "prettier --check apps/web/src scripts/ui-snapshots.mjs",
    "ui:snapshot": "node scripts/ui-snapshots.mjs capture",
    "ui:compare": "node scripts/ui-snapshots.mjs compare"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.2"
  }
}
